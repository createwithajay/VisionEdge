# Virtual environments
venv/
venv_linux/

# Downloaded wheels
wheels/

# Model files (large binaries — regenerate locally, don't commit)
models/*.pt
models/*.onnx

# Compiled TensorRT engines (GPU-specific, not portable — don't commit)
engines/*.engine

# Benchmark/profiling outputs (regenerate locally — keep repo lean)
results/*.json
results/*.csv
# Keep chart PNGs though — useful to show in the repo without rerunning
!results/*.png

# Python cache
__pycache__/
*.pyc

# OS/editor junk
.DS_Store
*.swp
